<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 冷启动那一瞬间的窗口底色：深色模式下避免白屏闪一下 -->
    <style name="Theme.HvlgGuide" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 开屏页：主题底色 + 居中的书本图标，结束后切回正常主题 -->
    <style name="Theme.HvlgGuide.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.HvlgGuide</item>
    </style>
</resources>
